# Copy to .env and fill in. .env is gitignored; never commit a real value.
#
# The server loads this file at start (Node >= 20.6). A key set here wins over
# data/secrets.json, so a deploy never depends on a file on disk.

# Sarvam API key. Leave empty to use the key stored from the Connections page.
SARVAM_API_KEY=

# Port for `pnpm ui` (default 4173).
PORT=4173
